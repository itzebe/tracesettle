# Secrets — never commit
.env
.env.*
!.env.example
# Placeholder-only production template (contains no real values; validated by
# deploy/production/validate_config.py). The un-ignored name ends in ".example".
!deploy/production/.env.production.example
*.pem
*.key
# Service credential stores (hashes only, but still never commit)
*.creds.json
credentials.json
# Their advisory lock files
*.creds.json.lock
credentials.json.lock

# Durable guard-state database (spent nonces, counters). Never a build artefact.
guard-state.db
guard-state.db-wal
guard-state.db-shm
*.state.db
*.state.db-wal
*.state.db-shm

# Durable NEAR Intents lifecycle database (intent records; no signing material).
intents.db
intents.db-wal
intents.db-shm
*.intents.db
*.intents.db-wal
*.intents.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
dist/
build/

# Vercel CLI local state (project link; may hold org/project ids)
.vercel/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local scratch
*.log

# Agent workspace state (not part of the project)
.openhands/
