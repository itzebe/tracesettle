# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
# Service credential stores (hashes only, but still never commit)
*.creds.json
credentials.json
# Their advisory lock files
*.creds.json.lock
credentials.json.lock

# Durable guard-state database (spent nonces, counters). Never a build artefact.
guard-state.db
guard-state.db-wal
guard-state.db-shm
*.state.db
*.state.db-wal
*.state.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
dist/
build/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local scratch
*.log

# Agent workspace state (not part of the project)
.openhands/
