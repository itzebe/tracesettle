# TRACESETTLE — production configuration template.
#
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit real values here.
# Copy it to your platform's secret manager (Render/Fly/Railway/Cloud Run
# environment variables) and fill the values there. Do not create a filled-in
# copy inside the repository.
#
# Format: KEY=VALUE, one per line, no shell quoting. Lines starting with '#' are
# comments. Every variable below is read by tracesettle/config.py.
#
# Legend for the "Required" column in the section comments:
#   MANDATORY-PROD  must be set for a public deployment (fail-closed otherwise)
#   REQUIRED        must be set for the feature named
#   OPTIONAL        has a safe default
#   SECRET          never log, never commit, store in the platform secret manager

# ---------------------------------------------------------------------------
# 1. Network bind  (OPTIONAL — the image already sets these)
# ---------------------------------------------------------------------------
# Inside the container the image sets TRACESETTLE_HOST=0.0.0.0 and PORT=8000.
# A non-loopback bind requires the two credentials in sections 2 and 3.
# TRACESETTLE_HOST=0.0.0.0
# TRACESETTLE_PORT=8000

# ---------------------------------------------------------------------------
# 2. Public API authentication  (MANDATORY-PROD, SECRET)
# ---------------------------------------------------------------------------
# Gates POST /api/investigate and every GET/POST /api/guard/* endpoint.
# Sent by clients as the header:  X-API-Key: <value>
# GET / and GET /api/health stay open (liveness only).
TRACESETTLE_API_KEY=<SET_IN_HOSTING_SECRET_MANAGER>

# ---------------------------------------------------------------------------
# 3. Guard authorization signing key  (MANDATORY-PROD, SECRET)
# ---------------------------------------------------------------------------
# Hex (>=64 hex chars) or base64 (>=32 decoded bytes). Minimum 32 bytes.
# MUST be stable across restarts and identical on every instance: it signs the
# authorization tokens, and a changing key invalidates outstanding tokens and
# breaks cross-instance verification. A short/weak key is refused at start-up.
# Generate once:  python3 -c "import secrets;print(secrets.token_hex(32))"
TRACESETTLE_GUARD_AUTH_KEY=<GENERATE_AND_SET_SECURELY>

# ---------------------------------------------------------------------------
# 4. Shared guard state (PostgreSQL)  (REQUIRED for >1 instance, SECRET DSN)
# ---------------------------------------------------------------------------
# Multi-instance deployments MUST use PostgreSQL so nonces, spending counters,
# revocations and idempotency keys are shared. Use a DIRECT or SESSION-pooled
# connection string (port 5432 / Supabase :5432 session pooler) — NOT a
# transaction-mode pooler (Neon -pooler, Supabase :6543, Render :6432), which
# remaps the backend connection between transactions and breaks the session-level
# advisory lock used during schema migration. See ARCHITECTURE.md.
TRACESETTLE_GUARD_STATE_BACKEND=postgresql
TRACESETTLE_GUARD_STATE_PG_DSN=<SET_IN_HOSTING_SECRET_MANAGER>
# Hard production guard: refuse to start unless PostgreSQL is the active backend.
TRACESETTLE_GUARD_REQUIRE_POSTGRES=1
# Connection/statement timeouts (seconds / milliseconds).
# TRACESETTLE_GUARD_STATE_PG_CONNECT_TIMEOUT_S=10
# TRACESETTLE_GUARD_STATE_PG_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# 5. Audit log  (RECOMMENDED-PROD)
# ---------------------------------------------------------------------------
# When set, every security event is appended as one JSON line to this path
# (append-only; the in-memory hash chain still bounds reads). Mount a volume
# writable by uid 10001 so the log survives container replacement. Without it
# the audit log is in-memory only. The head digest is exposed for external
# anchoring — see AUDIT_ANCHORING.md.
# TRACESETTLE_GUARD_AUDIT_LOG=/data/audit.jsonl
# TRACESETTLE_GUARD_AUDIT_MAX_RECORDS=10000

# ---------------------------------------------------------------------------
# 6. NEAR RPC  (REQUIRED-PROD for historical settlement verification)
# ---------------------------------------------------------------------------
# Primary: recent transactions. Fallback (comma-separated list): archival nodes,
# tried in order when the primary answers NOT_FOUND. A historical transaction
# needs an ARCHIVE node; free public nodes are non-archival and answer
# UNKNOWN_TRANSACTION. The free archive endpoint is deprecated and hard
# rate-limited, so production should point the fallback at a paid archive node.
# See NEAR_ARCHIVAL_RPC.md.
TRACESETTLE_NEAR_RPC_URL=<VERIFIED_PRIMARY_RPC>
TRACESETTLE_NEAR_RPC_FALLBACK_URL=<VERIFIED_ARCHIVAL_RPC>

# ---------------------------------------------------------------------------
# 7. Investigation endpoint tunables  (OPTIONAL — safe defaults shown)
# ---------------------------------------------------------------------------
# TRACESETTLE_CLIENT_TIMEOUT=10        # per-connection socket timeout (s)
# TRACESETTLE_MAX_CONCURRENCY=16       # max concurrent worker threads
# TRACESETTLE_REQUEST_QUEUE=64
# TRACESETTLE_RATE_LIMIT_PER_MINUTE=60 # per-client-IP, investigate endpoint
# TRACESETTLE_RATE_LIMIT_BURST=15
# TRACESETTLE_HOST_RATE_LIMIT_PER_MINUTE=240  # per-upstream-host
# TRACESETTLE_HOST_RATE_LIMIT_BURST=60
# TRACESETTLE_HTTP_TIMEOUT=12
# TRACESETTLE_HTTP_ATTEMPTS=2
# TRACESETTLE_HTTP_BACKOFF=0.6
# TRACESETTLE_CACHE_TTL=45
# TRACESETTLE_CACHE_MAX_ENTRIES=512

# ---------------------------------------------------------------------------
# 8. Guard tunables  (OPTIONAL — safe defaults shown)
# ---------------------------------------------------------------------------
# TRACESETTLE_GUARD_RATE_LIMIT_PER_MINUTE=120  # per-client-IP, guard endpoints
# TRACESETTLE_GUARD_RATE_LIMIT_BURST=30
# TRACESETTLE_GUARD_MAX_BODY_BYTES=8192
# TRACESETTLE_GUARD_STATE_RETENTION_SECONDS=86400

# ---------------------------------------------------------------------------
# 9. Service-identity credentials  (OPTIONAL — only with TRACESETTLE_REQUIRE_SERVICE_AUTH)
# ---------------------------------------------------------------------------
# Path to a JSON credential registry (preferred) or the JSON inline. Each entry
# holds a hashed service credential. Never commit the real file or value.
# TRACESETTLE_REQUIRE_SERVICE_AUTH=1
# TRACESETTLE_SERVICE_CREDENTIALS=/run/secrets/service-credentials.json
# TRACESETTLE_SERVICE_CREDENTIALS_JSON=<SET_IN_HOSTING_SECRET_MANAGER>
